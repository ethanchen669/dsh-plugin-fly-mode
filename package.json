{
  "name": "@dsh-fly/dsh-plugin-fly-mode",
  "version": "0.1.0",
  "description": "Fly 安全模式（agent preset `fly`）作为一个可安装的 bundle 层：装进任何 profile 后，那里就能服务 fly preset（治跨 profile 的 agent-preset/not-found）。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanchen669/dsh-plugin-fly-mode.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-plugin-fly-binary": "0.1.0",
    "dsh-plugin-fly-reverse": "0.1.0",
    "dsh-plugin-fly-pwn": "0.1.0",
    "dsh-plugin-fly-diag": "0.1.0",
    "dsh-plugin-fly-recon": "0.1.0",
    "dsh-plugin-fly-blackbox": "0.1.0",
    "dsh-plugin-fly-smart": "0.1.0",
    "dsh-plugin-fly-guard": "0.1.0"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}

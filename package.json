{
  "name": "@dsh-fly/dsh-plugin-fly-mode",
  "version": "0.1.2",
  "description": "Fly 安全模式（agent preset `fly`）作为一个可安装的包：自带 7 个 Fly 工具（源码内联在包内 tools/，行表用本包子路径引用），并依赖单独发布的 dsh-plugin-fly-smart；装进任何 profile 后那里就能服务 fly preset。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanchen669/dsh-plugin-fly-mode.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "dsh-plugin-fly-smart": "^0.1.0"
  }
}

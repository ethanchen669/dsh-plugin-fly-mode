{
  "name": "@dsh-fly/dsh-plugin-fly-mode",
  "version": "0.1.17",
  "description": "Fly 模式作为一个可安装的包：**两个 preset** —— Fly 安全模式（preset-fly，8 个安全工具内联 + smart）与 Fly 标准模式（preset-fly-standard，上游 standard 的行表 + smart，无安全工具）；依赖单独发布的 dsh-plugin-fly-smart。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanchen669/dsh-plugin-fly-mode.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "dsh-plugin-fly-smart": "^0.1.2",
    "@dsh-fly/dsh-plugin-fly-engagement": "^0.1.4"
  }
}
